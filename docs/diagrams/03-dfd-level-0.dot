digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.65", splines=ortho, fontname="Arial", fontsize=22, labelloc=t, label="Figure 3. DFD Level 0 — System context\nOne process represents the complete CampusOne system", fontcolor="#183544"];
node [fontname="Arial", fontsize=12, shape=box, style="filled", fillcolor="white", color="#526976", penwidth=1.2, margin="0.17,0.12"];
edge [fontname="Arial", fontsize=10, color="#526976", fontcolor="#344955", arrowsize=0.7];
student [shape=box,penwidth=1.8,label="Student"];
faculty [shape=box,penwidth=1.8,label="Faculty"];
hod [shape=box,penwidth=1.8,label="Department administrator"];
admin [shape=box,penwidth=1.8,label="College administrator"];
provider [shape=box,penwidth=1.8,label="External AI provider\n(optional server configuration)"];
system [shape=box,style="rounded,filled",fillcolor="#edf4f6",label="0\nCAMPUSONE\nCampus information platform"];
student -> system [label="Credentials, search, bookmarks,\nevent registration, questions"];
system -> student [label="Session, scoped content, saved items,\nregistration result, answers/citations"];
faculty -> system [label="Credentials, circulars/events, class updates,\nAI draft/summary requests"];
system -> faculty [label="Session, permitted content,\nmoderation outcome, editable AI text"];
hod -> system [label="Credentials, department content,\ncontent/account approval decisions"];
system -> hod [label="Session, own-department queue,\nmanagement results"];
admin -> system [label="Credentials, roles, calendar/career changes,\ncontent and account decisions"];
system -> admin [label="Session, college management data,\noperation results"];
system -> provider [label="Task + minimal permitted context\n(no account records / provider key stays server-side)"];
provider -> system [label="Generated JSON or provider error"];
}