digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.65", splines=ortho, fontname="Arial", fontsize=22, labelloc=t, label="Figure 2. CampusOne — Academic and notification ER diagram\nCompanion to Figure 1; repeated USERS and DEPARTMENTS are the same entities", fontcolor="#183544"];
node [fontname="Arial", fontsize=12, shape=box, style="filled", fillcolor="white", color="#526976", penwidth=1.2, margin="0.17,0.12"];
edge [fontname="Arial", fontsize=10, color="#526976", fontcolor="#344955", arrowsize=0.7];
dep [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>DEPARTMENTS</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">code, name</TD></TR></TABLE>>];
usr [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">role, departmentCode</TD></TR></TABLE>>];
exam [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>EXAMS</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">departmentCode, course, semester</TD></TR><TR><TD ALIGN="LEFT">subjectCode, date, room</TD></TR></TABLE>>];
fac [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>FACULTY (directory)</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">departmentId, name, email</TD></TR><TR><TD ALIGN="LEFT">subjects[]</TD></TR></TABLE>>];
cal [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>CALENDAR</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">scope, departmentCode?</TD></TR><TR><TD ALIGN="LEFT">title, startDate, endDate?</TD></TR></TABLE>>];
cn [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>CLASS_NOTICES</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">facultyId (user ID)</TD></TR><TR><TD ALIGN="LEFT">departmentCode, course, semester</TD></TR><TR><TD ALIGN="LEFT">subjectCode, message, readByUserIds[]</TD></TR></TABLE>>];
car [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>CAREER</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">departmentCodes[] or ALL</TD></TR><TR><TD ALIGN="LEFT">type, company, role, status</TD></TR><TR><TD ALIGN="LEFT">applicationDeadline, applyUrl</TD></TR></TABLE>>];
nt [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>NOTIFICATIONS</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">userId or ALL</TD></TR><TR><TD ALIGN="LEFT">targetDepartmentCode?</TD></TR><TR><TD ALIGN="LEFT">title, message, type</TD></TR></TABLE>>];
nr [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>NOTIFICATION_READS</B></TD></TR><TR><TD ALIGN="LEFT">PK / FK user_id</TD></TR><TR><TD ALIGN="LEFT">PK / FK notification_id</TD></TR></TABLE>>];
ft [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#526976"><TR><TD ALIGN="LEFT" BGCOLOR="#e9f0f3"><B>FACILITIES</B></TD></TR><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">name, category, location</TD></TR><TR><TD ALIGN="LEFT">timings, contact</TD></TR></TABLE>>];
dep -> exam [dir=none,style=dashed,label="department code",taillabel="1",headlabel="0..N",labeldistance=2];
dep -> fac [dir=none,style=dashed,label="directory membership",taillabel="1",headlabel="0..N",labeldistance=2];
dep -> cal [dir=none,style=dashed,label="optional department scope",taillabel="1",headlabel="0..N",labeldistance=2];
usr -> cn [dir=none,style=dashed,label="faculty author",taillabel="1",headlabel="0..N",labeldistance=2];
usr -> nr [dir=none,style=solid,label="read state",taillabel="1",headlabel="0..N",labeldistance=2];
nt -> nr [dir=none,style=solid,label="read state",taillabel="1",headlabel="0..N",labeldistance=2];
dep -> car [dir=none,style=dashed,label="M:N eligibility via codes[]\nALL means campus-wide"];
notes [shape=note,label="FACULTY is a directory, not the login account table.\nFACILITIES are campus-wide; there is no department FK.\nNotification recipients use a user ID, ALL or department targeting.\nNo separate APPROVALS, SUBJECTS or TIMETABLES table exists.\nApproval state is stored on notices/events; schedules are sample data."];
ft -> notes [style=invis];
}